# Copy to .env if you want local overrides. Do not commit .env.
# Values already exported in the shell take precedence over this file.
# This project has no secrets. Do not put real student data or credentials here.

CAMPUS_LOG_LEVEL=INFO
CAMPUS_RANDOM_SEED=42
CAMPUS_MAX_RETRIES=3
CAMPUS_RETRY_BACKOFF_SECONDS=0.5
CAMPUS_DEFAULT_RECORD_COUNT=10000
CAMPUS_PING_INTERVAL_SECONDS=60
CAMPUS_GAP_THRESHOLD_SECONDS=300
CAMPUS_PARQUET_COMPRESSION=zstd

# Optional path overrides. Relative paths resolve against the repository root.
# CAMPUS_DATA_DIR=data
# CAMPUS_RAW_DIR=data/raw
# CAMPUS_QUARANTINE_DIR=data/quarantine
# CAMPUS_PARTITIONED_STORE_DIR=data/partitioned_store
# CAMPUS_METADATA_DB_PATH=data/pipeline_metadata.sqlite
